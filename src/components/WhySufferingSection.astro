---
import { Image } from 'astro:assets';
import obesityImg from '../assets/images/suffering-obesity.jpg';
import underweightImg from '../assets/images/suffering-underweight.jpg';
---

<section class="why-suffering section" id="why-suffering">
  <div class="container">
    <span class="section__label gsap-fade-up" data-en="The Reality" data-hi="सच्चाई">The Reality</span>
    <h2 class="section__title gsap-fade-up">
      <span data-en="Why Are You" data-hi="आप क्यों">Why Are You</span> <span class="text-gradient" data-en="Suffering?" data-hi="तकलीफ़ में हैं?">Suffering?</span>
    </h2>
    <p class="section__subtitle gsap-fade-up" data-en="Millions of people silently struggle with their weight every single day. Understanding the root cause is the first step toward transformation." data-hi="करोड़ों लोग हर रोज़ चुपचाप अपने वज़न से जूझते हैं। बदलाव की ओर पहला कदम है — मूल कारण को समझना।">
      Millions of people silently struggle with their weight every single day.
      Understanding the root cause is the first step toward transformation.
    </p>

    <div class="why-suffering__grid gsap-stagger-parent">
      <!-- Overweight Card -->
      <div class="why-suffering__card gsap-stagger-child">
        <div class="why-suffering__card-image">
          <Image
            src={obesityImg}
            alt="The daily struggle with excess weight"
            width={600}
            height={340}
            class="why-suffering__img"
          />
          <div class="why-suffering__card-overlay"></div>
        </div>

        <div class="why-suffering__card-content">
          <div class="why-suffering__card-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 2a10 10 0 0 1 10 10c0 5.523-4.477 10-10 10S2 17.523 2 12"/>
              <path d="M12 6v6l4 2"/>
            </svg>
          </div>
          <h3 class="why-suffering__card-title" data-en="Overweight & Obesity" data-hi="अधिक वज़न और मोटापा">Overweight & Obesity</h3>
          <p class="why-suffering__card-text" data-html="true"
            data-en='Excess weight isn&apos;t just about appearance — it leads to <strong>chronic fatigue</strong>, <strong>joint pain</strong>, <strong>breathlessness</strong>, and increased risk of heart disease, diabetes, and depression. Studies show that 73% of obesity cases are linked to poor dietary habits, not genetics.'
            data-hi='अधिक वज़न सिर्फ़ दिखावट का मामला नहीं है — इससे <strong>लगातार थकान</strong>, <strong>जोड़ों में दर्द</strong>, <strong>साँस फूलना</strong>, और दिल की बीमारी, डायबिटीज़ व डिप्रेशन का ख़तरा बढ़ता है। अध्ययन बताते हैं कि 73% मोटापे के मामले ख़राब खान-पान से जुड़े हैं, आनुवंशिकी से नहीं।'>
            Excess weight isn't just about appearance — it leads to <strong>chronic fatigue</strong>, 
            <strong>joint pain</strong>, <strong>breathlessness</strong>, and increased risk of 
            heart disease, diabetes, and depression. Studies show that 73% of obesity cases are 
            linked to poor dietary habits, not genetics.
          </p>

          <ul class="why-suffering__symptoms">
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
              <span data-en="Constant fatigue & low energy" data-hi="लगातार थकान और कम ऊर्जा">Constant fatigue & low energy</span>
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
              <span data-en="Joint pain & reduced mobility" data-hi="जोड़ों में दर्द और कम गतिशीलता">Joint pain & reduced mobility</span>
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
              <span data-en="Breathlessness during daily tasks" data-hi="रोज़मर्रा के कामों में साँस फूलना">Breathlessness during daily tasks</span>
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
              <span data-en="Declining self-confidence" data-hi="आत्मविश्वास में कमी">Declining self-confidence</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Underweight Card -->
      <div class="why-suffering__card gsap-stagger-child">
        <div class="why-suffering__card-image">
          <Image
            src={underweightImg}
            alt="The hidden struggle of being underweight"
            width={600}
            height={340}
            class="why-suffering__img"
          />
          <div class="why-suffering__card-overlay"></div>
        </div>

        <div class="why-suffering__card-content">
          <div class="why-suffering__card-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2"/>
              <path d="M8 12h8M12 8v8"/>
            </svg>
          </div>
          <h3 class="why-suffering__card-title" data-en="Underweight & Weakness" data-hi="कम वज़न और कमज़ोरी">Underweight & Weakness</h3>
          <p class="why-suffering__card-text" data-html="true"
            data-en='Being underweight isn&apos;t "being lucky" — it causes <strong>weak immunity</strong>, <strong>muscle loss</strong>, <strong>hormonal imbalance</strong>, and constant fatigue. Research indicates that underweight individuals are 2x more likely to suffer from nutritional deficiencies and infections.'
            data-hi='कम वज़न होना "किस्मत" नहीं है — इससे <strong>कमज़ोर इम्यूनिटी</strong>, <strong>मांसपेशियों का नुकसान</strong>, <strong>हार्मोनल असंतुलन</strong>, और लगातार थकान होती है। शोध बताता है कि कम वज़न वाले लोगों में पोषण की कमी और संक्रमण का ख़तरा 2 गुना ज़्यादा होता है।'>
            Being underweight isn't "being lucky" — it causes <strong>weak immunity</strong>, 
            <strong>muscle loss</strong>, <strong>hormonal imbalance</strong>, and constant 
            fatigue. Research indicates that underweight individuals are 2x more likely to suffer 
            from nutritional deficiencies and infections.
          </p>

          <ul class="why-suffering__symptoms">
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
              <span data-en="Weak immune system & frequent illness" data-hi="कमज़ोर इम्यूनिटी और बार-बार बीमार होना">Weak immune system & frequent illness</span>
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
              <span data-en="Muscle wasting & low strength" data-hi="मांसपेशियों का क्षय और कम ताक़त">Muscle wasting & low strength</span>
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
              <span data-en="Hormonal & metabolic imbalance" data-hi="हार्मोनल और मेटाबॉलिक असंतुलन">Hormonal & metabolic imbalance</span>
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
              <span data-en="Social anxiety & lack of confidence" data-hi="सामाजिक चिंता और आत्मविश्वास की कमी">Social anxiety & lack of confidence</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="why-suffering__cta gsap-fade-up">
      <p class="why-suffering__cta-text" data-html="true"
        data-en='The good news? <strong>These problems are solvable.</strong> With the right nutrition and guidance, your body can heal and thrive.'
        data-hi='अच्छी ख़बर? <strong>ये समस्याएँ हल हो सकती हैं।</strong> सही पोषण और मार्गदर्शन से, आपका शरीर ठीक हो सकता है और फल-फूल सकता है।'>
        The good news? <strong>These problems are solvable.</strong> 
        With the right nutrition and guidance, your body can heal and thrive.
      </p>
      <a href="#look-fit" class="btn-primary">
        <span data-en="Imagine Your Fitter Self →" data-hi="अपने फिट रूप की कल्पना करें →">Imagine Your Fitter Self →</span>
      </a>
    </div>
  </div>
</section>

<style lang="scss">
  .why-suffering {
    background: $color-bg-secondary;
    position: relative;

    &::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 200px;
      background: linear-gradient($color-bg-primary, $color-bg-secondary);
      pointer-events: none;
    }

    &__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: $space-8;
      margin-bottom: $space-16;

      @include respond-to('lg') {
        grid-template-columns: 1fr 1fr;
        gap: $space-10;
      }
    }

    &__card {
      background: $color-bg-card;
      border: 1px solid $color-border;
      border-radius: $radius-xl;
      overflow: hidden;
      transition: all $transition-slow;

      &:hover {
        border-color: rgba($color-accent-emerald, 0.2);
        box-shadow: $shadow-lg;
        transform: translateY(-4px);
      }

      &-image {
        position: relative;
        overflow: hidden;
        height: 240px;

        @include respond-to('md') {
          height: 280px;
        }
      }

      &-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, transparent 40%, $color-bg-card);
      }

      &-content {
        padding: $space-8;
        padding-top: $space-4;
      }

      &-icon {
        @include flex-center;
        width: 56px;
        height: 56px;
        background: rgba($color-accent-emerald, 0.1);
        border-radius: $radius-lg;
        margin-bottom: $space-4;
        color: $color-accent-emerald;
      }

      &-title {
        @include heading($fs-xl);
        margin-bottom: $space-3;
      }

      &-text {
        @include body-text($fs-base);
        margin-bottom: $space-6;
        line-height: $lh-relaxed;

        strong {
          color: $color-text-primary;
        }
      }
    }

    &__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    &__symptoms {
      display: flex;
      flex-direction: column;
      gap: $space-3;

      li {
        display: flex;
        align-items: center;
        gap: $space-3;
        font-size: $fs-sm;
        color: $color-text-secondary;

        svg {
          flex-shrink: 0;
          color: $color-danger;
          opacity: 0.7;
        }
      }
    }

    &__cta {
      text-align: center;
      padding: $space-10;
      @include glass;
      border-radius: $radius-xl;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: $space-6;

      &-text {
        @include body-text($fs-lg);
        max-width: 600px;

        strong {
          color: $color-accent-emerald-light;
          font-weight: $fw-semibold;
        }
      }
    }
  }
</style>
