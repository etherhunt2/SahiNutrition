---
import { Image } from 'astro:assets';
import obesityImg from '../assets/images/suffering-obesity.jpg';
import underweightImg from '../assets/images/suffering-underweight.jpg';
---

<section class="why-suffering section" id="why-suffering">
  <div class="container">
    <span class="section__label gsap-fade-up">The Reality</span>
    <h2 class="section__title gsap-fade-up">
      Why Are You <span class="text-gradient">Suffering?</span>
    </h2>
    <p class="section__subtitle gsap-fade-up">
      Millions of people silently struggle with their weight every single day.
      Understanding the root cause is the first step toward transformation.
    </p>

    <div class="why-suffering__grid gsap-stagger-parent">
      <!-- Overweight Card -->
      <div class="why-suffering__card gsap-stagger-child">
        <div class="why-suffering__card-image">
          <Image
            src={obesityImg}
            alt="The daily struggle with excess weight"
            width={600}
            height={340}
            class="why-suffering__img"
          />
          <div class="why-suffering__card-overlay"></div>
        </div>

        <div class="why-suffering__card-content">
          <div class="why-suffering__card-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 2a10 10 0 0 1 10 10c0 5.523-4.477 10-10 10S2 17.523 2 12"/>
              <path d="M12 6v6l4 2"/>
            </svg>
          </div>
          <h3 class="why-suffering__card-title">Overweight & Obesity</h3>
          <p class="why-suffering__card-text">
            Excess weight isn't just about appearance — it leads to <strong>chronic fatigue</strong>, 
            <strong>joint pain</strong>, <strong>breathlessness</strong>, and increased risk of 
            heart disease, diabetes, and depression. Studies show that 73% of obesity cases are 
            linked to poor dietary habits, not genetics.
          </p>

          <ul class="why-suffering__symptoms">
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
              Constant fatigue & low energy
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
              Joint pain & reduced mobility
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
              Breathlessness during daily tasks
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
              Declining self-confidence
            </li>
          </ul>
        </div>
      </div>

      <!-- Underweight Card -->
      <div class="why-suffering__card gsap-stagger-child">
        <div class="why-suffering__card-image">
          <Image
            src={underweightImg}
            alt="The hidden struggle of being underweight"
            width={600}
            height={340}
            class="why-suffering__img"
          />
          <div class="why-suffering__card-overlay"></div>
        </div>

        <div class="why-suffering__card-content">
          <div class="why-suffering__card-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2"/>
              <path d="M8 12h8M12 8v8"/>
            </svg>
          </div>
          <h3 class="why-suffering__card-title">Underweight & Weakness</h3>
          <p class="why-suffering__card-text">
            Being underweight isn't "being lucky" — it causes <strong>weak immunity</strong>, 
            <strong>muscle loss</strong>, <strong>hormonal imbalance</strong>, and constant 
            fatigue. Research indicates that underweight individuals are 2x more likely to suffer 
            from nutritional deficiencies and infections.
          </p>

          <ul class="why-suffering__symptoms">
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
              Weak immune system & frequent illness
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
              Muscle wasting & low strength
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
              Hormonal & metabolic imbalance
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
              Social anxiety & lack of confidence
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="why-suffering__cta gsap-fade-up">
      <p class="why-suffering__cta-text">
        The good news? <strong>These problems are solvable.</strong> 
        With the right nutrition and guidance, your body can heal and thrive.
      </p>
      <a href="#look-fit" class="btn-primary">Imagine Your Fitter Self →</a>
    </div>
  </div>
</section>

<style lang="scss">
  .why-suffering {
    background: $color-bg-secondary;
    position: relative;

    &::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 200px;
      background: linear-gradient($color-bg-primary, $color-bg-secondary);
      pointer-events: none;
    }

    &__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: $space-8;
      margin-bottom: $space-16;

      @include respond-to('lg') {
        grid-template-columns: 1fr 1fr;
        gap: $space-10;
      }
    }

    &__card {
      background: $color-bg-card;
      border: 1px solid $color-border;
      border-radius: $radius-xl;
      overflow: hidden;
      transition: all $transition-slow;

      &:hover {
        border-color: rgba($color-accent-emerald, 0.2);
        box-shadow: $shadow-lg;
        transform: translateY(-4px);
      }

      &-image {
        position: relative;
        overflow: hidden;
        height: 240px;

        @include respond-to('md') {
          height: 280px;
        }
      }

      &-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, transparent 40%, $color-bg-card);
      }

      &-content {
        padding: $space-8;
        padding-top: $space-4;
      }

      &-icon {
        @include flex-center;
        width: 56px;
        height: 56px;
        background: rgba($color-accent-emerald, 0.1);
        border-radius: $radius-lg;
        margin-bottom: $space-4;
        color: $color-accent-emerald;
      }

      &-title {
        @include heading($fs-xl);
        margin-bottom: $space-3;
      }

      &-text {
        @include body-text($fs-base);
        margin-bottom: $space-6;
        line-height: $lh-relaxed;

        strong {
          color: $color-text-primary;
        }
      }
    }

    &__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    &__symptoms {
      display: flex;
      flex-direction: column;
      gap: $space-3;

      li {
        display: flex;
        align-items: center;
        gap: $space-3;
        font-size: $fs-sm;
        color: $color-text-secondary;

        svg {
          flex-shrink: 0;
          color: $color-danger;
          opacity: 0.7;
        }
      }
    }

    &__cta {
      text-align: center;
      padding: $space-10;
      @include glass;
      border-radius: $radius-xl;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: $space-6;

      &-text {
        @include body-text($fs-lg);
        max-width: 600px;

        strong {
          color: $color-accent-emerald-light;
          font-weight: $fw-semibold;
        }
      }
    }
  }
</style>
