---
import { Image } from 'astro:assets';
import coachImg from '../assets/images/coach-portrait.jpg';
---

<section class="who-we-are section" id="who-we-are">
  <div class="container">
    <div class="who-we-are__grid">
      <div class="who-we-are__image gsap-fade-left">
        <div class="who-we-are__image-wrapper">
          <Image
            src={coachImg}
            alt="Your health and fitness coach"
            width={500}
            height={650}
            class="who-we-are__img"
          />
          <div class="who-we-are__image-accent"></div>
        </div>

        <div class="who-we-are__experience glass-card">
          <span class="who-we-are__experience-number">12+</span>
          <span class="who-we-are__experience-label">Years of Transforming Lives</span>
        </div>
      </div>

      <div class="who-we-are__content gsap-fade-right">
        <span class="section__label" style="text-align: left;">Who We Are</span>
        <h2 class="who-we-are__title">
          Not Just a Coach.<br />
          <span class="text-gradient">Your Health Partner.</span>
        </h2>

        <p class="who-we-are__text">
          At <strong>Sahi Nutrition</strong>, we believe fitness is not about perfection — 
          it's about progress. Founded by a certified health and fitness coach with over a 
          decade of experience, our mission is simple: <em>help every person discover their 
          body's true potential through the right nutrition.</em>
        </p>

        <p class="who-we-are__text">
          We've coached professionals, homemakers, students, and seniors. Every body 
          is different, and every plan we create reflects that. We don't believe in 
          one-size-fits-all diets. We believe in understanding your body, your lifestyle, 
          and your goals — then building a roadmap to get you there.
        </p>

        <div class="who-we-are__values gsap-stagger-parent">
          <div class="who-we-are__value gsap-stagger-child">
            <div class="who-we-are__value-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            </div>
            <div>
              <h4>Empathy First</h4>
              <p>We understand your struggles because we've been there. No judgement, only support.</p>
            </div>
          </div>

          <div class="who-we-are__value gsap-stagger-child">
            <div class="who-we-are__value-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
              </svg>
            </div>
            <div>
              <h4>Science-Backed</h4>
              <p>Every recommendation is grounded in nutritional science, not trends or fads.</p>
            </div>
          </div>

          <div class="who-we-are__value gsap-stagger-child">
            <div class="who-we-are__value-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
            <div>
              <h4>Sustainable Results</h4>
              <p>We build habits that last a lifetime, not quick fixes that fade in weeks.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .who-we-are {
    background: $color-bg-secondary;

    &__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: $space-12;
      align-items: center;

      @include respond-to('lg') {
        grid-template-columns: 0.9fr 1.1fr;
        gap: $space-16;
      }
    }

    &__image {
      position: relative;

      &-wrapper {
        position: relative;
        border-radius: $radius-xl;
        overflow: hidden;
        box-shadow: $shadow-xl;
      }

      &-accent {
        position: absolute;
        inset: 0;
        border-radius: $radius-xl;
        border: 2px solid transparent;
        background: $gradient-primary border-box;
        -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        opacity: 0.3;
        pointer-events: none;
      }
    }

    &__img {
      width: 100%;
      height: auto;
      object-fit: cover;
    }

    &__experience {
      position: absolute;
      bottom: -$space-6;
      right: -$space-4;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: $space-5 $space-6;
      background: rgba($color-bg-card, 0.9);
      backdrop-filter: blur(16px);
      border-radius: $radius-lg;
      border: 1px solid $color-border;
      box-shadow: $shadow-lg;

      @include respond-to('lg') {
        right: -$space-8;
      }

      &-number {
        font-family: $font-heading;
        font-size: $fs-3xl;
        font-weight: $fw-extrabold;
        @include gradient-text;
        line-height: 1;
      }

      &-label {
        font-size: $fs-xs;
        color: $color-text-muted;
        text-transform: uppercase;
        letter-spacing: $ls-wide;
        text-align: center;
        max-width: 120px;
      }
    }

    &__title {
      @include heading(clamp($fs-2xl, 4vw, $fs-4xl));
      text-align: left;
      margin-bottom: $space-6;
    }

    &__text {
      @include body-text($fs-md);
      margin-bottom: $space-5;

      strong {
        color: $color-accent-emerald-light;
      }

      em {
        color: $color-text-primary;
        font-style: normal;
        font-weight: $fw-medium;
      }
    }

    &__values {
      display: flex;
      flex-direction: column;
      gap: $space-6;
      margin-top: $space-8;
    }

    &__value {
      display: flex;
      gap: $space-4;
      align-items: flex-start;

      &-icon {
        @include flex-center;
        width: 48px;
        height: 48px;
        background: rgba($color-accent-emerald, 0.1);
        border-radius: $radius-md;
        color: $color-accent-emerald;
        flex-shrink: 0;
      }

      h4 {
        font-family: $font-heading;
        font-size: $fs-base;
        font-weight: $fw-semibold;
        color: $color-text-primary;
        margin-bottom: $space-1;
      }

      p {
        font-size: $fs-sm;
        color: $color-text-secondary;
        line-height: $lh-normal;
      }
    }
  }
</style>
