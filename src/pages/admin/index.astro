---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { readJson } from '../../utils/jsonDb';
import { FileText, Users, Eye, TrendingUp } from 'lucide-react';

if (!Astro.cookies.has('admin_session')) {
  return Astro.redirect('/admin/login');
}

let blogs = [];
try {
  blogs = await readJson<any[]>('blogs.json');
} catch (e) {
  blogs = [];
}
---

<AdminLayout title="Dashboard">
  <div class="dashboard">
    <header class="dashboard__header">
      <h1>Dashboard</h1>
      <p>Welcome back to Sahi Nutrition admin panel.</p>
    </header>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-card__icon"><FileText size={24} /></div>
        <div class="stat-card__info">
          <h3>Total Blogs</h3>
          <p class="stat-card__value">{blogs.length}</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-card__icon" style="color: #3b82f6;"><Users size={24} /></div>
        <div class="stat-card__info">
          <h3>Subscribers</h3>
          <p class="stat-card__value">1,248</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-card__icon" style="color: #a855f7;"><Eye size={24} /></div>
        <div class="stat-card__info">
          <h3>Total Views</h3>
          <p class="stat-card__value">45.2K</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-card__icon" style="color: #f59e0b;"><TrendingUp size={24} /></div>
        <div class="stat-card__info">
          <h3>Engagement</h3>
          <p class="stat-card__value">+12.5%</p>
        </div>
      </div>
    </div>

    <section class="dashboard__recent">
      <h2>Recent Blogs</h2>
      <div class="recent-list">
        {blogs.slice(-5).reverse().map(blog => (
          <div class="recent-item">
            <div class="recent-item__title">{blog.title}</div>
            <div class="recent-item__date">{new Date(blog.createdAt).toLocaleDateString()}</div>
          </div>
        ))}
        {blogs.length === 0 && <p style="color: #9ca3af;">No blogs found.</p>}
      </div>
    </section>
  </div>
</AdminLayout>

<style lang="scss">
  .dashboard {
    display: flex;
    flex-direction: column;
    gap: $space-8;

    &__header {
      h1 {
        font-family: $font-heading;
        font-size: $fs-2xl;
        color: $color-text-primary;
        margin-bottom: $space-2;
      }
      p {
        color: $color-text-secondary;
      }
    }

    &__recent {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: $radius-lg;
      padding: $space-6;

      h2 {
        font-size: $fs-lg;
        margin-bottom: $space-4;
        color: $color-text-primary;
      }
    }
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: $space-6;
  }

  .stat-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: $radius-lg;
    padding: $space-6;
    display: flex;
    align-items: center;
    gap: $space-4;

    &__icon {
      background: rgba(255, 255, 255, 0.05);
      padding: $space-3;
      border-radius: $radius-md;
      color: $color-accent-emerald;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    &__info {
      h3 {
        font-size: $fs-sm;
        color: $color-text-secondary;
        font-weight: $fw-medium;
      }
    }

    &__value {
      font-size: $fs-2xl;
      font-weight: $fw-bold;
      color: $color-text-primary;
      line-height: 1.2;
    }
  }

  .recent-list {
    display: flex;
    flex-direction: column;
    gap: $space-3;
  }

  .recent-item {
    display: flex;
    justify-content: space-between;
    padding: $space-3 $space-4;
    background: rgba(0, 0, 0, 0.3);
    border-radius: $radius-md;

    &__title {
      font-weight: $fw-medium;
      color: $color-text-primary;
    }

    &__date {
      color: $color-text-secondary;
      font-size: $fs-sm;
    }
  }
</style>
