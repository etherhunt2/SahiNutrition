---
import AdminLayout from '../../layouts/AdminLayout.astro';
import BlogListAdmin from '../../components/react/admin/BlogListAdmin';

if (!Astro.cookies.has('admin_session')) {
  return Astro.redirect('/admin/login');
}
---

<AdminLayout title="Manage Blogs">
  <header class="admin-header">
    <div class="admin-header__content">
      <h1>Manage Blogs</h1>
      <a href="/admin/add-blog" class="btn-primary" style="text-decoration: none;">Add New Blog</a>
    </div>
  </header>

  <section class="admin-content">
    <BlogListAdmin client:load />
  </section>
</AdminLayout>

<style lang="scss">
  .admin-header {
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding: $space-6 $space-8;

    &__content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      max-width: 1200px;
      margin: 0 auto;

      h1 {
        font-family: $font-heading;
        font-size: $fs-2xl;
        color: $color-text-primary;
      }
    }
  }

  .admin-content {
    padding: $space-8;
    max-width: 1200px;
    margin: 0 auto;
  }
</style>
